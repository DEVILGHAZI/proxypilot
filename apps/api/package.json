{
  "name": "@proxypilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.1",
    "@proxypilot/config": "workspace:*",
    "@proxypilot/database": "workspace:*",
    "@proxypilot/logger": "workspace:*",
    "@proxypilot/shared": "workspace:*",
    "@proxypilot/worker": "workspace:*",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "pino": "^9.9.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
