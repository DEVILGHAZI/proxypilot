{
  "name": "@proxypilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./health-queue": {
      "types": "./dist/health/enqueue.d.ts",
      "import": "./dist/health/enqueue.js"
    },
    "./request-queue": {
      "types": "./dist/request/enqueue.d.ts",
      "import": "./dist/request/enqueue.js"
    },
    "./site-check-queue": {
      "types": "./dist/site-check/enqueue.d.ts",
      "import": "./dist/site-check/enqueue.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@proxypilot/config": "workspace:*",
    "@proxypilot/database": "workspace:*",
    "@proxypilot/logger": "workspace:*",
    "@proxypilot/shared": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.8.0",
    "playwright-core": "^1.63.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
