    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
